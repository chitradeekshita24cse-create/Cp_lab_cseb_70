
import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        long[] arr = new long[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextLong();
        }
        long x = sc.nextLong();
        
        // Sorting the array to handle duplicates and use two pointers
        Arrays.sort(arr);
        boolean found = false;
        
        for (int i = 0; i < n - 2; i++) {
            // Skip duplicate elements for the first position
            if (i > 0 && arr[i] == arr[i - 1]) {
                continue;
            }
            
            int j = i + 1;
            int k = n - 1;
            
            while (j < k) {
                long currentSum = arr[i] + arr[j] + arr[k];
                
                if (currentSum == x) {
                    System.out.println(arr[i] + " " + arr[j] + " " + arr[k]);
                    found = true;
                    
                    // Skip duplicate elements for the second position
                    while (j < k && arr[j] == arr[j + 1]) {
                        j++;
                    }
                    // Skip duplicate elements for the third position
                    while (j < k && arr[k] == arr[k - 1]) {
                        k--;
                    }
                    
                    j++;
                    k--;
                } else if (currentSum < x) {
                    j++; // Need a larger sum
                } else {
                    k--; // Need a smaller sum
                }
            }
        }
        
        if (!found) {
            System.out.println("No Triplet Found");
        }
        
        sc.close();
    }
}
