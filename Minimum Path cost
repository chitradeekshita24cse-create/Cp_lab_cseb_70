n, m = map(int, input().split())
a = []
for i in range(n):
    a.append(list(map(int, input().split())))
dp = [[0] * m for _ in range(n)]
dp[0][0] = a[0][0]

for i in range(n):
    for j in range(m):

        if i == 0 and j == 0:
            continue
        values = []
        if i > 0:
            values.append(dp[i-1][j])
        if j > 0:
            values.append(dp[i][j-1])
        if i > 0 and j > 0:
            values.append(dp[i-1][j-1])
        dp[i][j] = a[i][j] + min(values)
print(dp[n-1][m-1])
