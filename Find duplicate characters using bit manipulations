import sys
s = sys.stdin.read().strip()
seen = 0     
printed = 0  
result = [] 
for char in s:

    bit_position = ord(char) - 97
    mask = 1 << bit_position

    if (seen & mask) != 0:
        if (printed & mask) == 0:
            result.append(char)
            printed = printed | mask   
    else:
        seen = seen | mask            
if len(result) > 0:
    print(" ".join(result))
else:
    print("No duplicates")
