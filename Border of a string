import sys
s = sys.stdin.read().strip()
n = len(s)
lps = [0] * n  
length = 0    
i = 1        

while i < n:
    if s[i] == s[length]:
        length = length + 1  
        lps[i] = length      
        i = i + 1            
    else:
        if length != 0:
            length = lps[length - 1]
        else:
            lps[i] = 0
            i = i + 1
border_length = lps[n - 1]
if border_length > 0:
    print(s[0:border_length]) 
else:
    print("") 
