#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    int a[n][m];
    int q[n * m][2];

    int front = 0, rear = 0;
    int fresh = 0, time = 0;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            scanf("%d", &a[i][j]);

            if (a[i][j] == 2) {
                q[rear][0] = i;
                q[rear][1] = j;
                rear++;
            }

            if (a[i][j] == 1)
                fresh++;
        }
    }

    while (front < rear && fresh > 0) {

        int size = rear - front;

        for (int k = 0; k < size; k++) {

            int r = q[front][0];
            int c = q[front][1];
            front++;

            int dr[] = {-1, 1, 0, 0};
            int dc[] = {0, 0, -1, 1};

            for (int d = 0; d < 4; d++) {

                int nr = r + dr[d];
                int nc = c + dc[d];

                if (nr >= 0 && nr < n &&
                    nc >= 0 && nc < m &&
                    a[nr][nc] == 1) {

                    a[nr][nc] = 2;
                    fresh--;

                    q[rear][0] = nr;
                    q[rear][1] = nc;
                    rear++;
                }
            }
        }

        time++;
    }

    if (fresh == 0)
        printf("%d", time);
    else
        printf("-1");

    return 0;
}
